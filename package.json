{
  "name": "dsh-excalidraw-canvas",
  "version": "0.1.0",
  "description": "Excalidraw canvas in the DSH right sidebar, with agent tools that read and edit the same scene.",
  "license": "MIT",
  "author": {
    "name": "dake6767",
    "email": "dake6767@users.noreply.github.com",
    "url": "https://github.com/dake6767"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "excalidraw",
    "diagram",
    "whiteboard",
    "canvas",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dake6767/dsh-excalidraw-canvas.git"
  },
  "homepage": "https://github.com/dake6767/dsh-excalidraw-canvas#readme",
  "bugs": {
    "url": "https://github.com/dake6767/dsh-excalidraw-canvas/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "lib/host-runtime.js",
    "assets/fonts",
    "skills",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-host.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:selection": "node scripts/check-selection.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.18.4",
    "@excalidraw/excalidraw": "^0.18.1",
    "esbuild": "^0.25.10"
  }
}
